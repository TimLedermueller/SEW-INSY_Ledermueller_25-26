Ein Inputselect: 

<InputSelect ValueExpression="@(() => SelectedCollection)"
             Value="@SelectedCollection"
             ValueChanged="@((string s) => OnChanged.InvokeAsync(s))">
    <option value="">-- auswählen --</option>
    @if (CollectionNames != null)
    {
        @foreach (var name in CollectionNames)
        {
            <option value="@name">@name</option>
        }
    }
</InputSelect>

@code {
    [Parameter] public string? SelectedCollection { get; set; }
    [Parameter] public List<string>? CollectionNames { get; set; }
    [Parameter] public EventCallback<string> OnChanged { get; set; }
}

