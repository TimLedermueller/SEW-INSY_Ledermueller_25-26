db.emps.aggregate([
  {
    $group: {
      _id: null,
      COUNT_MGR: {
        $sum: { $cond: [{ $ne: ["$MGR", null] }, 1, 0] }
      },
      DISTINCT_MGR: {
        $addToSet: "$MGR"
      }
    }
  },
  {
    $project: {
      _id: 0,
      COUNT_MGR: 1,
      COUNT_DISTINCT_MGR: {
        $size: {
          $filter: {
            input: "$DISTINCT_MGR",
            as: "mgr",
            cond: { $ne: ["$$mgr", null] }
          }
        }
      }
    }
  }
]);

